rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Everything lives under houses/<secret house code>/...
    // Only someone with the house link (the code) and the app's anonymous sign-in can reach it.
    // Listing all houses is not allowed, so the code cannot be discovered.
    match /houses/{house}/{rest=**} {
      allow read, write: if request.auth != null && house.size() >= 16;
    }
  }
}
